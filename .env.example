# .env (never commit — add to GitHub Secrets for Actions)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Anthropic key is NOT a client env var — it lives server-side only, as a
# Supabase Edge Function secret: `supabase secrets set ANTHROPIC_API_KEY=sk-ant-...`
